<?xml version="1.0" ?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:macro name="create_link" params="name name_link name_folder name_color rgba xyz rpy mass">
        <link name="${name_link}">
            <visual>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <geometry>
                    <mesh filename="package://my_robot_description/urdf/stl/${name_folder}/${name}.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="${name_color}">
                    <color rgba="${rgba}"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <geometry>
                    <mesh filename="package://my_robot_description/urdf/stl/${name_folder}/${name}.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:macro name="create_link_wheel" params="name name_link name_folder name_color rgba xyz_collition">
        <link name="${name_link}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://my_robot_description/urdf/stl/${name_folder}/${name}.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="${name_color}">
                    <color rgba="${rgba}"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${xyz_collition}" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder length="0.045674"
                            radius="0.035"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.3"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia
                    ixx="0.0002"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.0002"
                    iyz="0.0"
                    izz="0.0001"/>
            </inertial>
        </link>
</xacro:macro>

    <xacro:macro name="create_joint_fixed" params="name parent child xyz rpy">
        <joint name="${name}" type="fixed">
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="create_joint_continuous" params="name parent child xyz rpy axis">
        <joint name="${name}" type="continuous">
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="${axis}"/>
            <limit effort="30" velocity="20"/>
        </joint>
    </xacro:macro>

</robot>