<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="GazeboSystem" type="system">

        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <!-- Wheel 1 -->
        <joint name="base_link_to_right_wheel_1">

            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- Wheel 2 -->
        <joint name="base_link_to_right_wheel_2">

            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- Wheel 3 -->
        <joint name="base_link_to_left_wheel_3">

            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- Wheel 4 -->
        <joint name="base_link_to_left_wheel_4">

            <command_interface name="velocity">
                <param name="min">-20</param>
                <param name="max">20</param>
            </command_interface>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

    </ros2_control>

</robot>