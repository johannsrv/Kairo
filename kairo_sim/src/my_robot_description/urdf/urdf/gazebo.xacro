<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===================================================== -->
    <!-- CONTROLLER ARGUMENT -->
    <!-- ===================================================== -->

    <xacro:arg
        name="controllers_file"
        default="$(find my_robot_description)/config/controllers.yaml"
    />

    <!-- ===================================================== -->
    <!-- GZ_ROS2_CONTROL -->
    <!-- ===================================================== -->

    <gazebo>
        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>$(arg controllers_file)</parameters>

        </plugin>
    </gazebo>

    <gazebo reference="right_wheel_1_link">
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="right_wheel_2_link">
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="left_wheel_1_link">
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="left_wheel_2_link">
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="pantalla_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="altavoz_3_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="altavoz_3_2_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="matriz_de_microfono_resaker_12v_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="matriz_de_microfono_resaker_12v_1_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- ===================================================== -->
    <!-- LIDAR -->
    <!-- ===================================================== -->

    <gazebo reference="sensor_lidar_link">

        <sensor name="lidar_sensor" type="gpu_lidar">

            <pose realative_to="sensor_lidar_link">0 0 0 0 0 0</pose>

            <always_on>1</always_on>

            <visualize>1</visualize>

            <update_rate>2</update_rate>

            <topic>/scan</topic>

            <gz_frame_id>sensor_lidar_link</gz_frame_id>

            <lidar>

                <scan>

                    <horizontal>

                        <samples>720</samples>

                        <resolution>1</resolution>

                        <min_angle>-3.14159</min_angle>

                        <max_angle>3.14159</max_angle>

                    </horizontal>

                </scan>

                <range>

                    <min>0.10</min>

                    <max>10.0</max>

                    <resolution>0.005</resolution>

                </range>

                <noise>

                    <type>gaussian</type>

                    <mean>0.0</mean>

                    <stddev>0.001</stddev>
                </noise>

            </lidar>

        </sensor>

    </gazebo>

    <!-- ===================================================== -->
    <!-- IMU -->
    <!-- ===================================================== -->

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu</topic>

            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </z>
                </angular_velocity>

                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

</robot>